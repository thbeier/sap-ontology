{
  "@context": {
    "@version": 1.1,
    "sap":  "https://thbeier.github.io/sap-ontology/vocab#",
    "rdf":  "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl":  "http://www.w3.org/2002/07/owl#",
    "xsd":  "http://www.w3.org/2001/XMLSchema#",
    "sh":   "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dct":  "http://purl.org/dc/terms/",

    "name":          { "@id": "sap:name",          "@type": "xsd:string" },
    "description":   { "@id": "sap:description",   "@type": "xsd:string" },
    "externalId":    { "@id": "sap:externalId",    "@type": "xsd:string" },
    "processLevel":  { "@id": "sap:processLevel",  "@type": "xsd:string" },
    "bpmnType":      { "@id": "sap:bpmnType",      "@type": "xsd:string" },
    "transactionCode":          { "@id": "sap:transactionCode" },
    "configurationTransaction": { "@id": "sap:configurationTransaction" },

    "inScenario":    { "@id": "sap:inScenario",    "@type": "@id" },
    "hasProvenance": { "@id": "sap:hasProvenance", "@type": "@id" },

    "sourceSystem":            { "@id": "sap:sourceSystem",            "@type": "xsd:string" },
    "sourceUri":               { "@id": "sap:sourceUri",               "@type": "xsd:anyURI" },
    "sourceChunkId":           { "@id": "sap:sourceChunkId",           "@type": "xsd:string" },
    "sourceDocType":           { "@id": "sap:sourceDocType" },
    "sourcePage":              { "@id": "sap:sourcePage",              "@type": "xsd:integer" },
    "sourceSpan":              { "@id": "sap:sourceSpan",              "@type": "xsd:string" },
    "assertedBy":              { "@id": "sap:assertedBy",              "@type": "xsd:string" },
    "assertedRole":            { "@id": "sap:assertedRole" },
    "assertedAt":              { "@id": "sap:assertedAt",              "@type": "xsd:dateTime" },
    "extractedAt":             { "@id": "sap:extractedAt",             "@type": "xsd:dateTime" },
    "reviewedAt":              { "@id": "sap:reviewedAt",              "@type": "xsd:dateTime" },
    "recordedAt":              { "@id": "sap:recordedAt",              "@type": "xsd:dateTime" },
    "validFrom":               { "@id": "sap:validFrom",               "@type": "xsd:dateTime" },
    "validTo":                 { "@id": "sap:validTo",                 "@type": "xsd:dateTime" },
    "trustLevel":              { "@id": "sap:trustLevel" },
    "confidence":              { "@id": "sap:confidence",              "@type": "xsd:decimal" },
    "method":                  { "@id": "sap:method" },
    "extractorModel":          { "@id": "sap:extractorModel",          "@type": "xsd:string" },
    "promptVersion":           { "@id": "sap:promptVersion",           "@type": "xsd:string" },
    "supersedes":              { "@id": "sap:supersedes",              "@type": "@id" },
    "supersededBy":            { "@id": "sap:supersededBy",            "@type": "@id" },
    "relationshipToReference": { "@id": "sap:relationshipToReference" },
    "referenceProvenance":     { "@id": "sap:referenceProvenance",     "@type": "@id" },
    "overrideReason":          { "@id": "sap:overrideReason",          "@type": "xsd:string" },
    "baselinePhase":           { "@id": "sap:baselinePhase" },
    "clientTenant":            { "@id": "sap:clientTenant",            "@type": "xsd:string" },
    "changeStatus":            { "@id": "sap:changeStatus" },
    "statusEnteredAt":         { "@id": "sap:statusEnteredAt",         "@type": "xsd:dateTime" },
    "statusExitedAt":          { "@id": "sap:statusExitedAt",          "@type": "xsd:dateTime" },
    "externalChangeId":        { "@id": "sap:externalChangeId",        "@type": "xsd:string" },
    "approvalEvidenceUri":     { "@id": "sap:approvalEvidenceUri",     "@type": "xsd:anyURI" },

    "supportedBy":   { "@id": "sap:supportedBy",   "@type": "@id" },
    "realizedBy":    { "@id": "sap:realizedBy",    "@type": "@id" },
    "affects":       { "@id": "sap:affects",       "@type": "@id" },
    "executes":      { "@id": "sap:executes",      "@type": "@id" },
    "owns":          { "@id": "sap:owns",          "@type": "@id" },
    "consumes":      { "@id": "sap:consumes",      "@type": "@id" },
    "authorizedFor": { "@id": "sap:authorizedFor", "@type": "@id" },
    "linkedTo":      { "@id": "sap:linkedTo",      "@type": "@id" },
    "includes":      { "@id": "sap:includes",      "@type": "@id" },
    "carriedBy":     { "@id": "sap:carriedBy",     "@type": "@id" },
    "validates":     { "@id": "sap:validates",     "@type": "@id" },
    "represents":    { "@id": "sap:represents",    "@type": "@id" },
    "targetsScenario":{ "@id": "sap:targetsScenario","@type": "@id" },
    "implementedBy": { "@id": "sap:implementedBy", "@type": "@id" },
    "realizesCapability":{ "@id": "sap:realizesCapability","@type": "@id" },
    "contains":      { "@id": "sap:contains",      "@type": "@id" },
    "followedBy":    { "@id": "sap:followedBy",    "@type": "@id" },
    "produces":      { "@id": "sap:produces",      "@type": "@id" },
    "consumesDoc":   { "@id": "sap:consumesDoc",   "@type": "@id" },
    "routesTo":      { "@id": "sap:routesTo",      "@type": "@id" },
    "hostedOn":      { "@id": "sap:hostedOn",      "@type": "@id" },
    "mastersDataFor":{ "@id": "sap:mastersDataFor","@type": "@id" },
    "carries":       { "@id": "sap:carries",       "@type": "@id" },
    "dependsOn":     { "@id": "sap:dependsOn",     "@type": "@id" },
    "partOf":        { "@id": "sap:partOf",        "@type": "@id" },
    "occupiedBy":    { "@id": "sap:occupiedBy",    "@type": "@id" },
    "memberOf":      { "@id": "sap:memberOf",      "@type": "@id" }
  }
}
