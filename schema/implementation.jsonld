{
  "@context": "../context/sap-ontology-context.jsonld",
  "@graph": [
    { "@id": "sap:Configuration", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Configuration" },
    { "@id": "sap:Change", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Change" },
    { "@id": "sap:Transport", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Transport" },
    { "@id": "sap:TestCase", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Test Case" },
    { "@id": "sap:Incident", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Incident" },
    { "@id": "sap:Requirement", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" }, "rdfs:label": "Requirement" },
    { "@id": "sap:RicefwObject", "@type": "owl:Class",
      "rdfs:subClassOf": { "@id": "sap:ApplicationComponent" },
      "rdfs:label": "RICEFW Object",
      "rdfs:comment": "Customer-developed extension to the standard SAP product: Report, Interface, Conversion, Enhancement, Form, or Workflow. Subclass of ApplicationComponent because RICEFW is deployed software — just customer-built — so it inherits lifecycleState, vendor, deployment, tier, hostedOn, dependsOn. Distinguished from a standard ApplicationComponent by sap:ricefwType and sap:objectId (the Z*/Y*/customer-namespace identifier)." },

    { "@id": "sap:type",          "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:scope",         "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:mutability",    "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:hasValue",      "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:configurationTransaction",
      "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Configuration" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:label":  "Configuration Transaction (SPRO)",
      "rdfs:comment": "SAP SPRO/IMG transaction code that maintains this configuration, e.g. 'VOV8' for sales document types or 'V/08' for pricing procedures. The customizing handle for a Configuration, distinct from the executable T-code (sap:transactionCode) of an Activity. SPRO codes use slashes and dots more often than Activity T-codes (V/08, F.05)." },
    { "@id": "sap:status",        "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:changeStatus",  "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Change" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "SAP-transport delivery-pipeline status on a Change: draft, in-development, unit-tested, released-to-qa, qa-passed, released-to-prd, imported-to-prd, baseline-merged, plus rejected, rolled-back. Distinct from sap:lifecycleStage on Provenance, which records assertion maturity in a source-agnostic way." },
    { "@id": "sap:priority",      "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:requestedBy",   "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:approvedBy",    "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:transportId",   "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:sourceSystemRef","@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:targetSystem",  "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:releaseStatus", "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:testType",      "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:automated",     "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:boolean" } },
    { "@id": "sap:lastExecutionResult","@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:ticketId",      "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:title",         "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:severity",      "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:reportedAt",    "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:dateTime" } },
    { "@id": "sap:resolvedAt",    "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:dateTime" } },
    { "@id": "sap:source",        "@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "sap:acceptanceCriteria","@type": "owl:DatatypeProperty", "rdfs:range": { "@id": "xsd:string" } },

    { "@id": "sap:includes",    "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Change" },
      "rdfs:range":  { "@id": "sap:Configuration" } },
    { "@id": "sap:carriedBy",   "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Change" },
      "rdfs:range":  { "@id": "sap:Transport" } },
    { "@id": "sap:resultsIn",   "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Incident" },
      "rdfs:range":  { "@id": "sap:Change" } },

    { "@id": "sap:TransportImport", "@type": "owl:Class",
      "rdfs:label": "Transport Import",
      "rdfs:subClassOf": { "@id": "sap:DomainInstance" },
      "rdfs:comment": "A discrete STMS / Cloud ALM import event of one Transport into one System. Reified so the landscape progression of a Change (DEV→QA→PRD) is queryable, auditable, and replayable. Multiple TransportImports may exist per (Transport, System) pair when re-imports happen." },

    { "@id": "sap:importedAt",   "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:TransportImport" },
      "rdfs:range":  { "@id": "xsd:dateTime" } },
    { "@id": "sap:importedBy",   "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:TransportImport" },
      "rdfs:range":  { "@id": "xsd:string" } },
    { "@id": "sap:importResult", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:TransportImport" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:label":  "Import Result",
      "rdfs:comment": "Outcome of the STMS import: success, failed, in-progress, rolled-back." },

    { "@id": "sap:importedInto", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Transport" },
      "rdfs:range":  { "@id": "sap:TransportImport" },
      "rdfs:label":  "Imported Into",
      "rdfs:comment": "Transport→TransportImport: the discrete import events of a transport. A transport with no importedInto edges has been released but not yet imported anywhere." },
    { "@id": "sap:targets",      "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:TransportImport" },
      "rdfs:range":  { "@id": "sap:System" },
      "rdfs:label":  "Targets",
      "rdfs:comment": "TransportImport→System: which system received this transport." },

    { "@id": "sap:ricefwType", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:RicefwObject" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:label":  "RICEFW Type",
      "rdfs:comment": "Classification of the customer-developed object: Report, Interface, Conversion, Enhancement, Form, or Workflow. Drives routing in operate workflows (forms and interfaces have different debug paths)." },
    { "@id": "sap:objectId", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:RicefwObject" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:label":  "Object ID",
      "rdfs:comment": "The ABAP/namespaced identifier of the customer object: Z* / Y* / /CUSTOMER/* name. Used by gCTS / Git path resolution and by ATC / Code Inspector lookups." },
    { "@id": "sap:enhances", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:RicefwObject" },
      "rdfs:range":  { "@id": "sap:ApplicationComponent" },
      "rdfs:label":  "Enhances",
      "rdfs:comment": "RicefwObject→ApplicationComponent: the standard SAP component or object being extended (BAdI host, enhancement spot, user exit, standard report being copied-and-modified). Required for Reports/Interfaces/Conversions that replace standard behaviour; optional for greenfield Forms/Workflows." },
    { "@id": "sap:realizesActivity", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:RicefwObject" },
      "rdfs:range":  { "@id": "sap:Activity" },
      "rdfs:label":  "Realizes Activity",
      "rdfs:comment": "RicefwObject→Activity: the business action this customer object supports. Multi-valued — a single Z-report may serve multiple Activities. This is the edge that supports `graph.ricefw_for_activity` blast-radius queries during incident triage." }
  ]
}
