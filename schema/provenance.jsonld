{
  "@context": "../context/sap-ontology-context.jsonld",
  "@graph": [
    {
      "@id": "sap:Provenance",
      "@type": "owl:Class",
      "rdfs:label": "Provenance",
      "rdfs:comment": "Metadata attached to every asserted instance describing where the claim came from, who asserted it, when, and how much to trust it. Bitemporal: validFrom/validTo describe when the fact is true in the world; recordedAt is when the graph learned it. Lineage: supersedes/supersededBy chain prior assertions of the same fact. Lifecycle: changeStatus and related fields describe the AMS lifecycle when a Provenance attaches to a Change."
    },

    { "@id": "sap:sourceSystem", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Name of the system of record (e.g., 'signavio', 'leanix', 'cloud-alm', 'sap-direct', 'manual', 'ServiceNow', 'ChaRM', 'SolMan', 'spro-export', 'ki-os')." },
    { "@id": "sap:sourceUri", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:anyURI" } },
    { "@id": "sap:sourceChunkId", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Identifier of the source chunk in the vector store (bridges graph to vector layer)." },
    { "@id": "sap:sourceDocType", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Document classification: process-doc, functional-spec, technical-spec, test-case, training, runbook, spro-export, config-export, change-record." },
    { "@id": "sap:sourcePage", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:integer" },
      "rdfs:comment": "Page number within the source document (1-based)." },
    { "@id": "sap:sourceSpan", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Character offset span within the source chunk (e.g., '1283-1456')." },

    { "@id": "sap:assertedBy", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Identity that asserted the fact: 'agent:<name>@<version>' for automated extractors or 'user:<email>' for humans." },
    { "@id": "sap:assertedRole", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Role under which the assertion was made (lifecycle context). One of: requester, approver, tester-it, tester-uat, release-manager, rollback-coordinator, reviewer, auditor." },
    { "@id": "sap:assertedAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "Canonical timestamp for the assertion (when the asserter committed to the claim)." },
    { "@id": "sap:extractedAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "When an automated extractor produced the candidate (precedes review)." },
    { "@id": "sap:reviewedAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "When a human reviewer approved the assertion. Null/absent until reviewed." },
    { "@id": "sap:recordedAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "Graph transaction time — when the graph learned about the assertion. Bitemporal pair with validFrom/validTo." },

    { "@id": "sap:validFrom", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "When the asserted fact becomes true in the business world. Aligned to xsd:dateTime to match Scenario.validFrom." },
    { "@id": "sap:validTo", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "When the asserted fact stops being true. Absent or null while still current." },

    { "@id": "sap:trustLevel", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Reliability gradient. Legacy values: authoritative, verified, asserted, inferred, draft. Extended values for LLM-driven ingestion: extracted (LLM produced), reviewed (human inspected), confirmed (second pair-of-eyes), audited (formally signed off)." },
    { "@id": "sap:confidence", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:decimal" },
      "rdfs:comment": "Confidence score in [0.0, 1.0]. Self-rated by the extractor at extraction time; calibrated post-review." },
    { "@id": "sap:method", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "How the assertion was produced: manual, ETL, LLM-extracted, LLM-extraction, SPRO-export, config-export, change-record, manual-review." },
    { "@id": "sap:extractorModel", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Identifier of the model that produced the extraction (e.g., 'claude-sonnet-4-6@2026-01'). Required for reproducibility when method is LLM-extracted." },
    { "@id": "sap:promptVersion", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Version identifier (semver or hash) of the extractor prompt. Lets us identify assertions affected by a prompt regression." },

    { "@id": "sap:supersedes", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "sap:Provenance" },
      "rdfs:comment": "Points to the prior Provenance that this one replaces. Append-only lineage chain — never update or delete a Provenance." },
    { "@id": "sap:supersededBy", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "sap:Provenance" },
      "rdfs:comment": "Inverse of supersedes; populated for graph traversal convenience." },
    { "@id": "sap:relationshipToReference", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "How this client-baseline assertion relates to the reference enterprise baseline: confirms, overrides, extends." },
    { "@id": "sap:referenceProvenance", "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "sap:Provenance" },
      "rdfs:comment": "Pointer to the reference-baseline Provenance being confirmed, overridden, or extended." },
    { "@id": "sap:overrideReason", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Human-readable reason this client deviates from the reference baseline. Required when relationshipToReference is 'overrides'." },

    { "@id": "sap:baselinePhase", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Lifecycle phase of the assertion: reference (shipped baseline), client-transition (one-time take-over ingestion), client-update (steady-state operate)." },
    { "@id": "sap:clientTenant", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "Tenant identifier this assertion belongs to in a multi-tenant deployment." },

    { "@id": "sap:changeStatus", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "AMS change-lifecycle status when this Provenance records a Change transition: planned, in-progress, in-integration-test, in-uat, released-prod, rolled-back, rejected." },
    { "@id": "sap:statusEnteredAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "Timestamp the change entered the status carried by this Provenance." },
    { "@id": "sap:statusExitedAt", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "Timestamp the change left the status carried by this Provenance. Null while current." },
    { "@id": "sap:externalChangeId", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "External change-management ticket ID (ServiceNow CHG number, ChaRM request, Jira issue, etc.) — anchors the graph fact to the operational source of truth." },
    { "@id": "sap:approvalEvidenceUri", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Provenance" },
      "rdfs:range":  { "@id": "xsd:anyURI" },
      "rdfs:comment": "Pointer to evidence supporting the assertion (signed approval, test execution log, deployment record). Required for audited trustLevel." }
  ]
}
