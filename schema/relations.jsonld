{
  "@context": "../context/sap-ontology-context.jsonld",
  "@graph": [
    { "@id": "sap:supportedBy",    "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Activity" },
      "rdfs:range":  { "@id": "sap:ApplicationComponent" } },
    { "@id": "sap:realizedBy",     "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Activity" },
      "rdfs:comment": "Activity→enabler: the implementation artifact that realizes this business activity. Range is polymorphic — sap:Configuration (standard SAP customizing — SPRO entry) or sap:RicefwObject (customer extension — Z-report, BAdI, custom form). Both enable the Activity; the SHACL ActivityShape enforces the union via sh:or. (rdfs:range deliberately omitted because asserting a single range class triggers rdfs inference that mis-types one of the two valid target classes.) Replaces the v0.7.0 sap:realizesActivity edge (RicefwObject→Activity), which was direction-asymmetric with realizedBy and has been removed in v0.8.3." },
    { "@id": "sap:represents",     "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:BusinessDocument" },
      "rdfs:range":  { "@id": "sap:DataObject" } },
    { "@id": "sap:affects",        "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Change" },
      "rdfs:comment": "Change→enabler: the implementation artifact this Change modifies. Range is polymorphic — sap:Configuration (customizing entries) or sap:RicefwObject (customer-developed objects). SHACL ChangeShape enforces the union via sh:or. A Z-report fix is a Change affecting a RicefwObject, just as a SPRO tweak is a Change affecting a Configuration. (rdfs:range deliberately omitted; see sap:realizedBy for rationale.)" },
    { "@id": "sap:impacts",        "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Change" },
      "rdfs:range":  { "@id": "sap:Activity" },
      "rdfs:comment": "Derived at query time from sap:affects + sap:realizedBy. Not authored directly." },
    { "@id": "sap:linkedTo",       "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Incident" } },
    { "@id": "sap:executes",       "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Role" },
      "rdfs:range":  { "@id": "sap:Activity" } },
    { "@id": "sap:owns",           "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:OrgUnit" } },
    { "@id": "sap:consumes",       "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:OrgUnit" },
      "rdfs:range":  { "@id": "sap:ApplicationComponent" } },
    { "@id": "sap:authorizedFor",  "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Role" },
      "rdfs:range":  { "@id": "sap:Configuration" } },
    { "@id": "sap:realizesCapability","@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Process" },
      "rdfs:range":  { "@id": "sap:Capability" },
      "rdfs:comment": "Strategic-layer link from a Process to the durable business Capability it realizes. Optional: incident triage and change-impact queries do not traverse this edge. Populate when the tenant runs capability heat-maps, portfolio analytics, or EAM / LeanIX-style business-capability-model views. Multiple Processes may realize one Capability and one Process may realize multiple Capabilities (N:M). Distinct from sap:Requirement which models transactional asks against future Scenarios — Capability is the durable competence, Requirement is the path to change it." },
    { "@id": "sap:targetsScenario","@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Requirement" },
      "rdfs:range":  { "@id": "sap:Scenario" } },
    { "@id": "sap:implementedBy",  "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:Requirement" },
      "rdfs:range":  { "@id": "sap:Change" } },
    { "@id": "sap:validates",      "@type": "owl:ObjectProperty",
      "rdfs:domain": { "@id": "sap:TestCase" } },
    { "@id": "sap:inScenario",     "@type": "owl:ObjectProperty",
      "rdfs:range":  { "@id": "sap:Scenario" } },
    { "@id": "sap:hasProvenance",  "@type": "owl:ObjectProperty",
      "rdfs:range":  { "@id": "sap:Provenance" } }
  ]
}
