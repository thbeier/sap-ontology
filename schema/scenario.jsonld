{
  "@context": "../context/sap-ontology-context.jsonld",
  "@graph": [
    { "@id": "sap:Scenario", "@type": "owl:Class",
      "rdfs:label": "Scenario",
      "rdfs:comment": "A named state of the landscape. Every non-schema instance connects to at least one Scenario via sap:inScenario." },
    { "@id": "sap:scenarioType", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Scenario" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "One of: as-is, to-be, variant, best-practice. The best-practice value identifies an SAP-published reference Scenario (Solution Process, e.g. J45) that customer Processes may map to via sap:inScenario. Best-practice scenarios are loaded read-only and locked." },
    { "@id": "sap:scenarioCode", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Scenario" },
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:label":  "Scenario Code",
      "rdfs:comment": "Optional external identifier for a Scenario. For best-practice scenarios this carries the SAP Solution Process code (e.g. J45, BD9). For customer scenarios it may carry an internal code or be null." },
    { "@id": "sap:lifecycleState", "@type": "owl:DatatypeProperty",
      "rdfs:range":  { "@id": "xsd:string" },
      "rdfs:comment": "One of: draft, active, locked, superseded (for Scenario); planned, live, sunset, retired (for ApplicationComponent). Property is polymorphic — domain-specific enumerations are enforced in each class's SHACL shape." },
    { "@id": "sap:validFrom", "@type": "owl:DatatypeProperty",
      "rdfs:range":  { "@id": "xsd:dateTime" },
      "rdfs:comment": "Bitemporal validity start. Shared between sap:Scenario (when the named state begins) and sap:Provenance (when the asserted fact becomes true in the world). No rdfs:domain is declared because the property is intentionally polymorphic across both classes; per-class minCount/maxCount constraints live in the respective SHACL shapes." } ,
    { "@id": "sap:validUntil", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Scenario" },
      "rdfs:range":  { "@id": "xsd:dateTime" } },
    { "@id": "sap:projectLink", "@type": "owl:DatatypeProperty",
      "rdfs:domain": { "@id": "sap:Scenario" },
      "rdfs:range":  { "@id": "xsd:anyURI" } }
  ]
}
