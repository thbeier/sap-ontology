@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix sap:  <https://thbeier.github.io/sap-ontology/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

sap:ConfigurationShape
    a sh:NodeShape ;
    sh:targetClass sap:Configuration ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:name ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:type ; sh:datatype xsd:string ;
        sh:in ( "customizing" "custom-code" "parameter" ) ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:configurationTransaction ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "configurationTransaction is the canonical SPRO/IMG transaction maintaining this Configuration (e.g. VOV8, V/08, FBZP). Optional but unique when set." ;
        sh:pattern "^[A-Z][A-Z0-9_./-]+$" ] .

sap:ChangeShape
    a sh:NodeShape ;
    sh:targetClass sap:Change ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:name ;   sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:status ; sh:datatype xsd:string ;
        sh:in ( "draft" "requested" "approved" "in-progress" "deployed" "rejected" "rolled-back" ) ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:changeStatus ; sh:datatype xsd:string ;
        sh:in ( "draft" "in-development" "unit-tested" "released-to-qa"
                "qa-passed" "released-to-prd" "imported-to-prd" "baseline-merged"
                "rejected" "rolled-back" ) ;
        sh:maxCount 1 ;
        sh:message "changeStatus is the pinned landscape-progression enum; status remains the legacy free-form field. Set both during transition." ] ;
    sh:property [ sh:path sap:affects ; sh:class sap:Configuration ] .

sap:TransportShape
    a sh:NodeShape ;
    sh:targetClass sap:Transport ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:transportId ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:type ;        sh:datatype xsd:string ;
        sh:in ( "customizing" "workbench" ) ] ;
    sh:property [ sh:path sap:importedInto ; sh:class sap:TransportImport ] .

sap:TransportImportShape
    a sh:NodeShape ;
    sh:targetClass sap:TransportImport ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:importedAt ;   sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sap:importResult ; sh:datatype xsd:string ;
        sh:in ( "success" "failed" "in-progress" "rolled-back" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "TransportImport.importResult must be one of success, failed, in-progress, rolled-back." ] ;
    sh:property [ sh:path sap:importedBy ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path sap:targets ;    sh:class sap:System ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every TransportImport must target exactly one System." ] .

sap:TestCaseShape
    a sh:NodeShape ;
    sh:targetClass sap:TestCase ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:name ;     sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:testType ; sh:datatype xsd:string ;
        sh:in ( "unit" "integration" "regression" "UAT" ) ] .

sap:IncidentShape
    a sh:NodeShape ;
    sh:targetClass sap:Incident ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:ticketId ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:title ;    sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:severity ; sh:datatype xsd:string ;
        sh:in ( "critical" "high" "medium" "low" ) ] .

sap:RequirementShape
    a sh:NodeShape ;
    sh:targetClass sap:Requirement ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:name ;     sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path sap:priority ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sap:targetsScenario ; sh:class sap:Scenario ; sh:maxCount 1 ] ;
    sh:property [ sh:path sap:implementedBy ;   sh:class sap:Change ] .

sap:RicefwObjectShape
    a sh:NodeShape ;
    sh:targetClass sap:RicefwObject ;
    sh:node sap:DomainInstanceShape ;
    sh:property [ sh:path sap:name ;       sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sap:objectId ;   sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "RicefwObject.objectId is required — the Z*/Y*/customer-namespace identifier." ] ;
    sh:property [ sh:path sap:ricefwType ; sh:datatype xsd:string ;
        sh:in ( "Report" "Interface" "Conversion" "Enhancement" "Form" "Workflow" ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "RicefwObject.ricefwType must be one of Report, Interface, Conversion, Enhancement, Form, Workflow." ] ;
    sh:property [ sh:path sap:enhances ;          sh:class sap:ApplicationComponent ] ;
    sh:property [ sh:path sap:realizesActivity ;  sh:class sap:Activity ] ;
    sh:property [ sh:path sap:lifecycleState ; sh:datatype xsd:string ;
        sh:in ( "planned" "live" "sunset" "retired" ) ; sh:minCount 1 ; sh:maxCount 1 ] .
